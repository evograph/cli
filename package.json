{
  "name": "@evograph/cli",
  "version": "0.2.0-dev.0",
  "description": "Evograph CLI \u2014 evolution knowledge graph for your repo",
  "type": "module",
  "homepage": "https://evograph.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evograph/cli.git"
  },
  "bugs": {
    "url": "https://github.com/evograph/cli/issues"
  },
  "author": {
    "name": "Muhammad Atif",
    "email": "dev.muhammad.atif@gmail.com",
    "url": "https://acefolio.dev"
  },
  "license": "ISC",
  "keywords": [
    "evograph",
    "evolution",
    "knowledge-graph",
    "cli",
    "git",
    "decisions"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin",
    "dist"
  ],
  "bin": {
    "ecs": "./bin/ecs.js"
  },
  "scripts": {
    "dev": "tsx src/cli/run.ts",
    "build": "tsc && tsc-alias -p tsconfig.json",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build && npm run test",
    "bundle": "npm run build && node scripts/bundle.mjs",
    "build:bin": "npm run bundle && pkg build/ecs.cjs --targets node22-macos-x64,node22-macos-arm64,node22-linux-x64,node22-win-x64 --output dist/bin/ecs",
    "test": "npm run build && vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@modelcontextprotocol/server": "2.3.1",
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "^26.1.0",
    "@yao-pkg/pkg": "^6.21.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.6.0",
    "prettier": "^3.9.4",
    "tsc-alias": "^1.9.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
